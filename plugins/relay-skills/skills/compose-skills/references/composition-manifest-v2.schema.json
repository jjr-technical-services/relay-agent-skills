{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay.builtbyrose.co/schemas/relay.skill_composition_manifest.v2.json",
  "title": "Relay version-pinned skill composition manifest",
  "description": "A governed, immutable composition of child skills. Capability declarations never grant runtime authority.",
  "type": "object",
  "required": [
    "schemaVersion",
    "manifestId",
    "name",
    "version",
    "visibility",
    "qualityStatus",
    "dependencyPolicy",
    "authorityCeiling",
    "sources",
    "children",
    "routes",
    "qualification"
  ],
  "properties": {
    "schemaVersion": {
      "const": "relay.skill_composition_manifest.v2"
    },
    "manifestId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "visibility": {
      "enum": ["personal", "organization", "public"]
    },
    "qualityStatus": {
      "enum": ["unverified", "static_pass", "behaviorally_qualified", "production_observed"]
    },
    "dependencyPolicy": {
      "type": "object",
      "required": ["resolution", "freezeForRun", "allowFloatingRefs", "newVersionStatus"],
      "properties": {
        "resolution": {
          "const": "latest_trusted_at_run_start"
        },
        "freezeForRun": {
          "const": true
        },
        "allowFloatingRefs": {
          "const": false
        },
        "newVersionStatus": {
          "const": "unverified"
        }
      },
      "additionalProperties": false
    },
    "authorityCeiling": {
      "$ref": "#/$defs/authority"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/child"
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "qualification": {
      "$ref": "#/$defs/compositionQualification"
    },
    "lineage": {
      "type": "object",
      "properties": {
        "action": {
          "enum": ["create", "revision", "fork"]
        },
        "assetId": {
          "type": "string"
        },
        "assetVersionId": {
          "type": "string"
        },
        "parentAssetId": {
          "type": "string"
        },
        "sourceVersionId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "authority": {
      "type": "object",
      "required": ["allowed", "prohibited", "requiresApproval"],
      "properties": {
        "allowed": {
          "$ref": "#/$defs/stringArray"
        },
        "prohibited": {
          "$ref": "#/$defs/stringArray"
        },
        "requiresApproval": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "required": ["spdx", "path", "sha256", "copyPolicy"],
      "properties": {
        "spdx": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "copyPolicy": {
          "enum": ["copy_permitted", "link_only", "unresolved"]
        },
        "noticePaths": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["id", "repo", "commit", "tree", "license"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "repo": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "trustNote": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "provenanceAlias": {
      "type": "object",
      "required": ["repo", "commit", "path", "packageDigestSha256", "relationship"],
      "properties": {
        "repo": {
          "type": "string"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "path": {
          "type": "string"
        },
        "packageDigestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "relationship": {
          "enum": ["byte_identical_mirror", "provider_adapter", "semantic_variant", "historical_alias"]
        }
      },
      "additionalProperties": false
    },
    "toolRequirement": {
      "type": "object",
      "required": ["name", "source", "required"],
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "enum": ["declared", "inferred"]
        },
        "required": {
          "type": "boolean"
        },
        "constraint": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "scopeRequirement": {
      "type": "object",
      "required": ["provider", "scope", "mode"],
      "properties": {
        "provider": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "mode": {
          "enum": ["read", "write", "admin"]
        }
      },
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "required": ["tier", "factors"],
      "properties": {
        "tier": {
          "enum": ["low", "medium", "high", "critical"]
        },
        "factors": {
          "$ref": "#/$defs/stringArray"
        },
        "mitigations": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": false
    },
    "gateState": {
      "enum": ["not_run", "passed", "failed"]
    },
    "childQualification": {
      "type": "object",
      "required": [
        "status",
        "positive",
        "nearMiss",
        "holdout",
        "redGreen",
        "approvalBoundary",
        "evaluatorIndependent",
        "autoActivation"
      ],
      "properties": {
        "status": {
          "enum": ["unverified", "static_pass", "behaviorally_qualified", "production_observed"]
        },
        "evaluationSuiteDigest": {
          "$ref": "#/$defs/sha256"
        },
        "positive": {
          "$ref": "#/$defs/gateState"
        },
        "nearMiss": {
          "$ref": "#/$defs/gateState"
        },
        "holdout": {
          "$ref": "#/$defs/gateState"
        },
        "redGreen": {
          "$ref": "#/$defs/gateState"
        },
        "approvalBoundary": {
          "$ref": "#/$defs/gateState"
        },
        "evaluatorIndependent": {
          "type": "boolean"
        },
        "autoActivation": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "autoActivation": {
                "const": true
              }
            },
            "required": ["autoActivation"]
          },
          "then": {
            "properties": {
              "status": {
                "enum": ["behaviorally_qualified", "production_observed"]
              },
              "positive": {
                "const": "passed"
              },
              "nearMiss": {
                "const": "passed"
              },
              "holdout": {
                "const": "passed"
              },
              "redGreen": {
                "const": "passed"
              },
              "approvalBoundary": {
                "const": "passed"
              },
              "evaluatorIndependent": {
                "const": true
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "child": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "sourceId",
        "path",
        "packageDigestSha256",
        "disposition",
        "tools",
        "scopes",
        "risk",
        "authority",
        "interface",
        "qualification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "sourceId": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "packageDigestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "relayContentHashSha256": {
          "$ref": "#/$defs/sha256"
        },
        "disposition": {
          "enum": ["eligible_for_qualification", "hold", "quarantine", "link_only"]
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenanceAlias"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolRequirement"
          }
        },
        "credentials": {
          "$ref": "#/$defs/stringArray"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scopeRequirement"
          }
        },
        "risk": {
          "$ref": "#/$defs/risk"
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "interface": {
          "type": "object",
          "required": ["inputs", "output", "preserve"],
          "properties": {
            "inputs": {
              "$ref": "#/$defs/stringArray"
            },
            "output": {
              "type": "object",
              "required": ["name", "type", "description"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "preserve": {
              "$ref": "#/$defs/stringArray"
            }
          },
          "additionalProperties": false
        },
        "qualification": {
          "$ref": "#/$defs/childQualification"
        }
      },
      "additionalProperties": false
    },
    "routeStep": {
      "type": "object",
      "required": ["childId", "order", "dependsOn", "failurePolicy"],
      "properties": {
        "childId": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "dependsOn": {
          "$ref": "#/$defs/stringArray"
        },
        "condition": {
          "type": "string"
        },
        "failurePolicy": {
          "type": "object",
          "required": ["mode", "maxAttempts"],
          "properties": {
            "mode": {
              "enum": ["stop", "retry", "continue"]
            },
            "maxAttempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": ["id", "domain", "selectionMode", "activationMode", "positiveSignals", "nearMissSignals", "steps"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "domain": {
          "type": "string"
        },
        "selectionMode": {
          "enum": ["one_best_match", "ordered_pipeline"]
        },
        "activationMode": {
          "enum": ["suggestion_only", "manual_only", "auto_after_qualification"]
        },
        "positiveSignals": {
          "$ref": "#/$defs/stringArray"
        },
        "nearMissSignals": {
          "$ref": "#/$defs/stringArray"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/routeStep"
          }
        },
        "ambiguityPolicy": {
          "enum": ["ask", "suggest_all", "no_match"]
        }
      },
      "additionalProperties": false
    },
    "compositionQualification": {
      "type": "object",
      "required": [
        "status",
        "positive",
        "nearMiss",
        "holdout",
        "redGreen",
        "authorityCeiling",
        "graphAcyclic",
        "aliasResolution",
        "newChildVersionResetsQualification"
      ],
      "properties": {
        "status": {
          "enum": ["unverified", "static_pass", "behaviorally_qualified", "production_observed"]
        },
        "positive": {
          "$ref": "#/$defs/gateState"
        },
        "nearMiss": {
          "$ref": "#/$defs/gateState"
        },
        "holdout": {
          "$ref": "#/$defs/gateState"
        },
        "redGreen": {
          "$ref": "#/$defs/gateState"
        },
        "authorityCeiling": {
          "$ref": "#/$defs/gateState"
        },
        "graphAcyclic": {
          "$ref": "#/$defs/gateState"
        },
        "aliasResolution": {
          "$ref": "#/$defs/gateState"
        },
        "newChildVersionResetsQualification": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
